# Copie para .env e preencha. O .env nunca entra no git.

# Obrigatorio: token do bot do Discord.
DISCORD_TOKEN=

# Chave do modelo usado na consolidacao de memoria (uma das duas).
CHAT_API_KEY=
# OPENCODE_API_KEY=

# Painel web. DASHBOARD_PORT=0 desliga.
DASHBOARD_PASSWORD=
DASHBOARD_PORT=8080
DASHBOARD_HOST=127.0.0.1

# Caminho do SQLite (padrao: data/bot.db).
# BOT_DB=data/bot.db

# Binario do yt-dlp.
YTDLP_BIN=yt-dlp

# 1 libera hosts privados nas ferramentas web. So para teste local.
# AGENT_ALLOW_PRIVATE=1
