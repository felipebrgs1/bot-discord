# Copie para .env e preencha. O .env nunca entra no git.

# Obrigatorio: token do bot do Discord.
DISCORD_TOKEN=

# Modelo da conversa, no formato provider/id do pi (ex.: openai-codex/gpt-6-luna).
# Vazio = padrao do pi (~/.pi/agent/settings.json). Credencial vem do login do pi.
AGENT_MODEL=

# Chave do modelo usado na consolidacao de memoria (uma das duas).
CHAT_API_KEY=
# OPENCODE_API_KEY=

# Painel web. DASHBOARD_PORT=0 desliga.
DASHBOARD_PASSWORD=
DASHBOARD_PORT=8080
DASHBOARD_HOST=127.0.0.1

# Caminho do SQLite (padrao: data/bot.db).
# BOT_DB=data/bot.db

# Binario do yt-dlp.
YTDLP_BIN=yt-dlp

# Imagem (tool generate_image na conversa e slash /gerar) pelo OpenRouter
# (https://openrouter.ai/settings/keys).
# Modelo so de imagem; padrao inclusionai/ming-image-0.1-design.
OPENROUTER_API_KEY=
# OPENROUTER_IMAGE_MODEL=inclusionai/ming-image-0.1-design

# Pesquisa web (tool web_search). Tavily primeiro, Firecrawl de reserva quando o
# Tavily falha ou nao acha nada (ex.: cota do plano free). Pelo menos uma.
# https://app.tavily.com  |  https://www.firecrawl.dev/app/api-keys
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# 1 libera hosts privados nas ferramentas web. So para teste local.
# AGENT_ALLOW_PRIVATE=1
